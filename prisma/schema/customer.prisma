enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Customer {
  id              String         @id @default(cuid())
  name            String
  phone           String         @unique
  email           String?
  nidNumber       String         @unique
  address         String
  profileImage    String?
  
  // Guarantor Info
  guarantorName   String
  guarantorPhone  String
  guarantorNid    String?
  guarantorRelation String?

  status          CustomerStatus @default(ACTIVE)

  // Relations
  createdById     String
  
  // Future Relations
  loans           Loan[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("customer")
}